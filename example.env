# =========================
# PostgreSQL
# =========================
DB_HOST=database
DATABASE_NAME=postgresql
POSTGRES_USER=admin
POSTGRES_PASSWORD=testpassword
DATABASE_PORT=5432

# =========================
# Django
# =========================
DEBUG=1  # 0 = production, 1 = development
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminpassword
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://0.0.0.0:8000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8282,http://127.0.0.1:8282
CORS_ORIGIN_WHITELIST=http://0.0.0.0:8000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8282,http://127.0.0.1:8282
DJANGO_SECRET_KEY='YOUR_SECRET_KEY'   

# =========================
# Backend Port 
# =========================
BACKEND_PORT=8000

GHCR_OWNER=yourGitHubUsername